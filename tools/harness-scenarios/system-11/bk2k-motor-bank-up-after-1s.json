{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Black Knight 2000 Williams System 11B MOTOR BANK TEST (test 08) probe: UP switch 16 raised to 1 one second after the test is located. Synthetic host stimulus; the harness models no bank travel.",
  "watch_switches": [
    -7,
    -6,
    16,
    24
  ],
  "actions": [
    {
      "type": "wait",
      "seconds": 16,
      "label": "stabilize initialized ROM"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 0,
      "settle_s": 0.3,
      "label": "manual down"
    },
    {
      "type": "pulse",
      "switch": -7,
      "hold_ms": 200,
      "settle_s": 2,
      "label": "enter tests"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "settle_s": 0.3,
      "label": "auto up"
    },
    {
      "type": "pulse_until_display",
      "switch": -7,
      "texts": [
        "MOTOR BANK TEST"
      ],
      "max_pulses": 20,
      "hold_ms": 200,
      "settle_s": 1.5,
      "label": "locate MOTOR BANK TEST"
    },
    {
      "type": "wait",
      "seconds": 1.0,
      "label": "delay after the test is located"
    },
    {
      "type": "set_switch",
      "switch": 16,
      "state": 1,
      "settle_s": 0.0,
      "label": "present switch 16 = 1"
    },
    {
      "type": "wait",
      "seconds": 20,
      "label": "observe the ROM's response"
    },
    {
      "type": "set_switch",
      "switch": 16,
      "state": 0,
      "settle_s": 0.2,
      "label": "return switch 16 to 0"
    },
    {
      "type": "wait",
      "seconds": 12,
      "label": "observe after the switches return to 0"
    }
  ]
}
