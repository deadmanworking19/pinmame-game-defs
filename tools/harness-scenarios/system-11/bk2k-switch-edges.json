{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Black Knight 2000 Williams System 11B Switch Edges test (07): each switch edge the ROM sees is named on the player 1/2 line with its number on the player 3 line. One public switch address is changed per step with a settle window and then restored; switch 39 (ROM name LEFT OUTLANE) is the same-run control. Keyboard handling stays off, so host switch writes are not overwritten by cabinet input ports. No ball, mechanism or game state is modelled.",
  "watch_switches": [
    -7,
    -6
  ],
  "actions": [
    {
      "type": "wait",
      "seconds": 16,
      "label": "stabilize initialized ROM"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 0,
      "settle_s": 0.3,
      "label": "manual down"
    },
    {
      "type": "pulse",
      "switch": -7,
      "hold_ms": 200,
      "settle_s": 2,
      "label": "enter tests"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "settle_s": 0.3,
      "label": "auto up"
    },
    {
      "type": "pulse_until_display",
      "switch": -7,
      "texts": [
        "SWITCH EDGES"
      ],
      "max_pulses": 15,
      "hold_ms": 200,
      "settle_s": 1.5,
      "label": "locate SWITCH EDGES"
    },
    {
