{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "game": "sshtl_l7",
  "notes": "Space Shuttle L-7 replay credit award with direct public switch writes only. Three balls rest on ball ramp switches 10, 11 and 12; a coin and the credit button start a game and the served ball is plunged. Forty long-ramp shots (upper switch 32 then lower switch 45) raise the score past the factory first replay level, which awards a credit (credit display 00 to 01) and shows what the ROM drives for a credit award. Run from an NVRAM initialized by one prior empty-NVRAM power-up.",
  "watch_switches": [
    -7,
    -6
  ],
  "actions": [
    {
      "type": "wait",
      "seconds": 6.0,
      "label": "boot into game-over attract mode"
    },
    {
      "type": "set_switch",
      "switch": 10,
      "state": 1,
      "settle_s": 0.3,
      "label": "ball resting on top ball ramp position (10)"
    },
    {
      "type": "set_switch",
      "switch": 11,
      "state": 1,
      "settle_s": 0.3,
      "label": "ball resting on middle ball ramp position (11)"
    },
    {
      "type": "set_switch",
      "switch": 12,
      "state": 1,
      "settle_s": 1.0,
      "label": "ball resting on lower ball ramp position (12)"
    },
    {
      "type": "pulse",
      "switch": 6,
      "hold_ms": 150,
      "settle_s": 2.0,
      "label": "coin on the left coin switch"
    },
