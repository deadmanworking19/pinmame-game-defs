      "type": "pulse_until_display",
      "switch": -7,
      "texts": [
        "ACTIVE SWITCH TEST"
      ],
      "hold_ms": 250,
      "settle_s": 1.5,
      "max_pulses": 40,
      "label": "Find ROM Active Switch Test header"
    },
    {
      "type": "wait_until_output",
      "channel": "solenoid",
      "addresses": [
        23
      ],
      "timeout_s": 8,
      "active_only": true,
      "label": "Wait for Active Switch Test readiness"
    },
