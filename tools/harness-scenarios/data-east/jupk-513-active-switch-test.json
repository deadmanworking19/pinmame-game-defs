{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "game": "jupk_513",
  "notes": "Fresh empty CMOS, 8 s boot, every trough and mechanism switch open. No named keys are used, so PinMAME keyboard handling stays off and the host's direct cabinet writes are not overwritten by the driver's keyboard port: Green is held at 1 (the diagnostic direction) and Black (-7) is pulsed to step. Exact DMD title templates (tools/jurassic_park_harness.py) replace press counts and output 23 marks readiness. The ROM's Switch Test title does not repaint on a closure, so the ACTIVE SWITCH TEST is used: each public matrix switch 1-62 is closed in turn and the held DMD frame names it with its wire colours and number; the flipper buttons are the PinMAME flipper-column addresses 84 (left) and 82 (right), which core_updateSw copies to 63/64. Host switch readback is not ROM evidence.",
  "watch_switches": [
    63,
    64,
    82,
    84
  ],
  "actions": [
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "settle_s": 0.5,
      "label": "Hold Green in the diagnostic direction"
    },
