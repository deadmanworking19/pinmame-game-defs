{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Boot an NBA S.A.M. ROM from an empty NVRAM and enter the switch test with the named Back and Select service keys (Back, then Select five times: service-menu splash, icon menu, diagnostics menu, switch menu, switch test). Every public switch starts at 0. Hold each matrix switch 1-64, then each dedicated-switch address 65-72, 81-88 and -7 to -4, in turn for 1.2 s with a snapshot while held, then release it for 0.6 s. The switch test prints the name the ROM gives a switch while the ROM reads it as active. The named service keys drive the coin-door buttons 0, -1, -2 and -3, so these four are not held directly. The scenario names no driver.",
  "actions": [
    {
      "label": "boot",
      "seconds": 30.0,
      "type": "wait"
    },
    {
      "hold_ms": 400,
      "key": "service_green",
      "label": "Back",
      "settle_s": 3.0,
      "type": "pulse_key"
    },
    {
      "hold_ms": 700,
      "key": "service_select",
      "label": "Select 1: SERVICE MENU splash",
      "settle_s": 3.0,
      "type": "pulse_key"
    },
    {
      "hold_ms": 700,
      "key": "service_select",
      "label": "Select 2: icon menu, DIAG highlighted",
      "settle_s": 3.0,
      "type": "pulse_key"
    },
    {
      "hold_ms": 700,
      "key": "service_select",
      "label": "Select 3: diagnostics menu, SW highlighted",
      "settle_s": 5.0,
      "type": "pulse_key"
    },
    {
      "hold_ms": 700,
      "key": "service_select",
      "label": "Select 4: switch menu, TEST highlighted",
      "settle_s": 4.0,
      "type": "pulse_key"
    },
    {
      "hold_ms": 700,
      "key": "service_select",
      "label": "Select 5: switch test",
      "settle_s": 4.0,
      "type": "pulse_key"
    },
